{{!
Це код container файлу для index сторінки,
в якому міститься код, котрий буде віддаватися по шляху (PATH) - "/"
}}
<main class="main">
  <div class="main-content">
    <header class="header-choose">
      <a href="/">
        <img src="/svg/back.svg">
      </a>
    </header>
    <h1 class="title title-center title-small">Назвіть плейліст</h1>

    <form method="post" action="/spotify-create{{#if data.isMix}}?isMix=true{{/if}}" class="form">
      <input type="text" class="form-field" placeholder="Назва" name="name">

      <button class="form-button">Створити</button>

    </form> 

  </div>

</main>


