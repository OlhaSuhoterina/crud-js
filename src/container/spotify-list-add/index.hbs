{{!
Це код container файлу для index сторінки,
в якому міститься код, котрий буде віддаватися по шляху (PATH) - "/"
}}
<main class="main">
  {{#with data}}
  <div class="main-content">
      <header class="header-choose">   
        <a  href="/">
        <img src="/svg/back.svg">
      </a>
      </header>
     <h1 class="title title-center">{{name}}</h1>

    
    <ul class="track-list">
      {{#each tracks}}
      <li class="track">

        <img src="{{image}}">
        <div class="track-content">
          <strong class="track-name">{{name}}</strong>
          <em class="track-autor">{{author}}</em>
        </div>
        <a href="/spotify-track-add?playListId={{../playListId}}&trackId={{id}}">
          <img src="/svg/addButtonTracks.svg" class="choose-image">
        </a>
       

      </li>
      {{/each}}

    </ul>



   

  </div>
{{/with}}
</main>


