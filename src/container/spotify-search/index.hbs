{{!
Це код container файлу для index сторінки,
в якому міститься код, котрий буде віддаватися по шляху (PATH) - "/"
}}


<main class="main">
  {{#with data}}
  <div class="main-content">
        <header class="header-choose">
          <a href="/">
            <img src="/svg/back.svg">
          </a>
        </header>
    <h1 class="title title-center">Пошук плейліста</h1>

    <form method="post" action="spotify-search" class="search">
      <img src="svg/search.svg">
      <input type="search" class="search-input" placeholder="Введить запит" name="value" value="{{value}}">
      <button class="search-button">Пошук</button>

    </form>

    <ul class="playlist">
      {{#each list}}
      <li class="playlist-list">
        <img src="{{image}}" alt="{{name}}">
        <div class="playlist-content">
          <strong class="playlist-name">{{name}}</strong>
          <span class="playlist-amount"> Кількість пісень: {{amount}}</span>
        </div>
      </li>
      {{/each}}
    </ul>
  </div>
  {{/with}}
</main>

